__pycache__/
.venv/
.env
*.db
*.sqlite3

pinterest_cookies.json
etsy_datadome.txt
pinterest_test.html

# Windows NTFS is case-insensitive, so `.claude/skills/` and `.claude/Skills/` are ONE
# directory here — but git is case-sensitive and would happily commit both spellings.
# On a Linux/macOS checkout that becomes two real directories which then drift apart.
# Track the lowercase spelling only.
.claude/Skills/
request_cache.db

# Contains a captured live Etsy session (32 cookies incl. session-key-*, uaid).
# Untracked 2026-08-12 — it is credentials, not config. Keep it local.
etsy/api/private/registry.json

# Redis persistence — holds the cookie vault (cookie:etsy:profile_*, cookies_json).
# Committing it leaks live sessions, same class as .env and registry.json.
dump.rdb
*.rdb

# Scraped payload caches and run artefacts — regenerated, and large.
pinterest/data/cache/
etsy/data/cache/
etsy/data/logs/
etsy/data/reports/
**/request_cache.db

# Local probe scripts
test_session.py

# env backups — they contain the same secrets as .env
.env.bak*
.env.*.bak

# vault backups contain LIVE session cookies — never commit
data/vault_backup_*.json

# conversation transcript dumps, not source
look her/

# redis dump artifact
dump.rdb

# Generated home screen — rebuilt daily by the scheduler from the database.
etsy/data/ui/
