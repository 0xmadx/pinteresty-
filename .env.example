# Copy this file to .env and fill in what you need. .env itself is gitignored —
# never commit real values. See docs/QUICKSTART.md for the full setup walkthrough.

# --- the vault (usually leave this alone) ---------------------------------------
# Has a working default matching docker-compose.yml. Only change it if you're
# running Redis somewhere other than the default Docker setup.
REDIS_URL='redis://localhost:6379/0'

# --- Printify (required for /pod and any POD-costing tool) ---------------------
# Get one at printify.com -> Settings -> Connections -> Generate token.
# Without this, pod_check.py and the MCP pod_quote tool will refuse to run.
PRINTIFY_API_TOKEN=

# --- optional -------------------------------------------------------------------
# DeepSeek: only used to summarise review text into pain points. Never produces
# a number the system acts on (D-27). Leave blank and that one feature is skipped.
DEEPSEEK_API_KEY=

# The optional read server (run_server.cmd). Defaults shown are safe — HOST stays
# on 127.0.0.1 unless you deliberately want it reachable from your LAN, which
# exposes your private market data with NO auth.
# HOST=127.0.0.1
# PORT=8100
# MARKET_DB=market_intelligence.db

# A residential/rotating proxy for the scraper, if you use one. Off by default.
# USE_PROXY=False
# PROXY_URL=http://user:pass@host:port

# Only relevant if you're deliberately probing DataDome behaviour by hand.
# DATADOME_COOKIE=
