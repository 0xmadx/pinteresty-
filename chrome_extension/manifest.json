{
  "manifest_version": 3,
  "name": "Scraper Cookie Syncer",
  "version": "1.2.0",
  "description": "Automatically syncs cookies for Etsy and Pinterest to the local Python scraper backend.",
  "permissions": [
    "cookies",
    "alarms",
    "tabs",
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "*://*.etsy.com/*",
    "*://*.pinterest.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.etsy.com/*",
        "*://*.pinterest.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scraper Profile Settings"
  }
}